generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  login          String          @unique
  name           String
  password       String
  role           Role            @default(WAITER)
  deliveries     Delivery[]
  orders         Order[]
  stockMovements StockMovement[]
  stopLists      StopList[]
  messages       Message[]

  @@map("users")
}

enum Role {
  ADMIN
  MANAGER
  WAITER
  KITCHEN
}

enum StopType {
  AUTO
  MANUAL
}

enum MessageType {
  WRITE_OFF
}

model Unit {
  id   String @id @default(cuid()) @map("id_unit")
  name String @unique

  products Product[]

  @@map("units")
}

model Product {
  id          String @id @default(cuid()) @map("id_product")
  nameProduct String @map("name_product")

  idUnit String @map("id_unit")
  unit   Unit   @relation(fields: [idUnit], references: [id])

  batches         Batch[]
  dishIngredients DishIngredient[]
  orderExclusions OrderItemExclusion[]

  @@map("products")
}

model Supplier {
  id String @id @default(cuid()) @map("id_supplier")
  name String
  nameKey String @unique @map("name_key")
  deliveries Delivery[]

  @@map("suppliers")
}

model Delivery {
  id         String   @id @default(cuid()) @map("id_delivery")
  number     String
  createDate DateTime @default(now()) @map("create_date")
  supplierId String? @map("supplier_id")
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  requestId String? @unique @map("request_id")
  requestHash String? @map("request_hash")

  createrId String @map("creater_id")
  creater   User   @relation(fields: [createrId], references: [id])

  batches Batch[]

  @@unique([supplierId, number])
  @@index([createDate, id])
  @@map("delivery")
}

model Batch {
  id    String   @id @default(cuid()) @map("id_batch")
  count Decimal  @db.Decimal(12, 3)
  EXP   DateTime @map("exp")
  receivedCount Decimal? @db.Decimal(12, 3) @map("received_count")
  productNameAtReceipt String? @map("product_name_at_receipt")
  unitNameAtReceipt String? @map("unit_name_at_receipt")

  idProduct String  @map("id_product")
  product   Product @relation(fields: [idProduct], references: [id])

  idDelivery String   @map("id_delivery")
  delivery   Delivery @relation(fields: [idDelivery], references: [id])

  stockMovements StockMovement[]

  @@index([idProduct, EXP])
  @@map("batch")
}

model Order {
  id         String   @id @default(cuid()) @map("id_order")
  createDate DateTime @default(now()) @map("create_date")

  createrId String @map("creater_id")
  creater   User   @relation(fields: [createrId], references: [id])

  items          OrderItem[]
  stockMovements StockMovement[]

  @@map("orders")
}

model OrderItem {
  id    String @id @default(cuid()) @map("id_order_item")
  count Int

  idOrder String @map("id_order")
  order   Order  @relation(fields: [idOrder], references: [id], onDelete: Cascade)

  idDish String @map("id_dish")
  dish   Dish   @relation(fields: [idDish], references: [id])

  // Продукты, которые гость попросил убрать: со склада они не списываются
  exclusions OrderItemExclusion[]

  @@map("order_item")
}

model OrderItemExclusion {
  idOrderItem String    @map("id_order_item")
  orderItem   OrderItem @relation(fields: [idOrderItem], references: [id], onDelete: Cascade)

  // Удалить из справочника можно только неиспользуемый продукт — старые пометки «без» уходят вместе с ним
  idProduct String  @map("id_product")
  product   Product @relation(fields: [idProduct], references: [id], onDelete: Cascade)

  @@id([idOrderItem, idProduct])
  @@map("order_item_exclusions")
}

model Dish {
  id   String @id @default(cuid()) @map("id_dish")
  name String
  version Int @default(1)
  deletedAt DateTime? @map("deleted_at")
  // Путь к фото блюда от корня бэкенда: /uploads/dishes/<файл>
  image String?

  ingredients DishIngredient[]
  orderItems  OrderItem[]
  stopLists   StopList[]

  @@map("dishes")
  @@index([deletedAt, name])
}

model DishIngredient {
  id    String  @id @default(cuid()) @map("id_dish_ingredient")
  count Decimal @db.Decimal(12, 3)

  idDish String @map("id_dish")
  dish   Dish   @relation(fields: [idDish], references: [id], onDelete: Cascade)

  idProduct String  @map("id_product")
  product   Product @relation(fields: [idProduct], references: [id])

  @@unique([idDish, idProduct])
  @@map("dish_ingredients")
}

model StockMovement {
  id         String   @id @default(cuid()) @map("id_stock_movement")
  count      Decimal  @db.Decimal(12, 3)
  createDate DateTime @default(now()) @map("create_date")

  idBatch String @map("id_batch")
  batch   Batch  @relation(fields: [idBatch], references: [id])

  idOrder String? @map("id_order")
  order   Order?  @relation(fields: [idOrder], references: [id])

  createrId String @map("creater_id")
  creater   User   @relation(fields: [createrId], references: [id])

  messages Message[]

  @@map("stock_movement")
}

model Message {
  id         String      @id @default(cuid()) @map("id_message")
  type       MessageType
  createDate DateTime    @default(now()) @map("create_date")
  isRead     Boolean     @default(false) @map("is_read")

  idRecipient String @map("id_recipient")
  recipient   User   @relation(fields: [idRecipient], references: [id], onDelete: Cascade)

  idStockMovement String?        @map("id_stock_movement")
  stockMovement   StockMovement? @relation(fields: [idStockMovement], references: [id], onDelete: Cascade)

  @@index([idRecipient, isRead])
  @@map("messages")
}

model StopList {
  id   String   @id @default(cuid()) @map("id_stop_list")
  type StopType

  idDish String @map("id_dish")
  dish   Dish   @relation(fields: [idDish], references: [id], onDelete: Cascade)

  createrId String? @map("creater_id")
  creater   User?   @relation(fields: [createrId], references: [id])

  @@unique([idDish, type])
  @@map("stop_list")
}
