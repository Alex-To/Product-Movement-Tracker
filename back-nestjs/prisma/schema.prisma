generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  login          String          @unique
  name           String
  password       String
  role           Role            @default(WAITER)
  deliveries     Delivery[]
  orders         Order[]
  stockMovements StockMovement[]
  stopLists      StopList[]
  messages       Message[]
  orderRejections OrderRejection[]

  @@map("users")
}

enum Role {
  ADMIN
  MANAGER
  WAITER
  KITCHEN
}

enum StopType {
  AUTO
  MANUAL
}

// Почему заказ не принят: вычисляется сервером, человек причину не вводит
enum RejectionReason {
  STOP_LIST
  SHORTAGE
  BUSY
}

enum MessageType {
  WRITE_OFF
}

model Unit {
  id   String @id @default(cuid()) @map("id_unit")
  name String @unique

  products Product[]

  @@map("units")
}

model Product {
  id          String @id @default(cuid()) @map("id_product")
  nameProduct String @map("name_product")

  idUnit String @map("id_unit")
  unit   Unit   @relation(fields: [idUnit], references: [id])

  batches         Batch[]
  dishIngredients DishIngredient[]
  orderExclusions OrderItemExclusion[]

  @@map("products")
}

model Supplier {
  id String @id @default(cuid()) @map("id_supplier")
  name String
  nameKey String @unique @map("name_key")
  deliveries Delivery[]

  @@map("suppliers")
}

model Delivery {
  id         String   @id @default(cuid()) @map("id_delivery")
  number     String
  createDate DateTime @default(now()) @map("create_date")
  supplierId String? @map("supplier_id")
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  requestId String? @unique @map("request_id")
  requestHash String? @map("request_hash")

  createrId String @map("creater_id")
  creater   User   @relation(fields: [createrId], references: [id])

  batches Batch[]

  @@unique([supplierId, number])
  @@index([createDate, id])
  @@map("delivery")
}

model Batch {
  id    String   @id @default(cuid()) @map("id_batch")
  count Decimal  @db.Decimal(12, 3)
  EXP   DateTime @map("exp")
  receivedCount Decimal? @db.Decimal(12, 3) @map("received_count")
  productNameAtReceipt String? @map("product_name_at_receipt")
  unitNameAtReceipt String? @map("unit_name_at_receipt")

  idProduct String  @map("id_product")
  product   Product @relation(fields: [idProduct], references: [id])

  idDelivery String   @map("id_delivery")
  delivery   Delivery @relation(fields: [idDelivery], references: [id])

  stockMovements StockMovement[]

  @@index([idProduct, EXP])
  @@map("batch")
}

model Order {
  id         String   @id @default(cuid()) @map("id_order")
  createDate DateTime @default(now()) @map("create_date")
  // Номер для кухни: сквозной круг 1…99, записывается при создании заказа
  number     Int      @map("number")
  // Когда кухня нажала «Заказ готов»; пусто — заказ ещё готовится
  readyAt    DateTime? @map("ready_at")

  createrId String @map("creater_id")
  creater   User   @relation(fields: [createrId], references: [id])

  items          OrderItem[]
  stockMovements StockMovement[]

  @@index([createDate, id])
  @@map("orders")
}

model OrderItem {
  id    String @id @default(cuid()) @map("id_order_item")
  count Int

  idOrder String @map("id_order")
  order   Order  @relation(fields: [idOrder], references: [id], onDelete: Cascade)

  idDish String @map("id_dish")
  dish   Dish   @relation(fields: [idDish], references: [id])

  // Продукты, которые гость попросил убрать: со склада они не списываются
  exclusions OrderItemExclusion[]

  @@map("order_item")
}

model OrderItemExclusion {
  idOrderItem String    @map("id_order_item")
  orderItem   OrderItem @relation(fields: [idOrderItem], references: [id], onDelete: Cascade)

  // Удалить из справочника можно только неиспользуемый продукт — старые пометки «без» уходят вместе с ним
  idProduct String  @map("id_product")
  product   Product @relation(fields: [idProduct], references: [id], onDelete: Cascade)

  @@id([idOrderItem, idProduct])
  @@map("order_item_exclusions")
}

model Dish {
  id   String @id @default(cuid()) @map("id_dish")
  name String
  version Int @default(1)
  deletedAt DateTime? @map("deleted_at")
  // Путь к фото блюда от корня бэкенда: /uploads/dishes/<файл>
  image String?

  ingredients DishIngredient[]
  orderItems  OrderItem[]
  stopLists   StopList[]

  @@map("dishes")
  @@index([deletedAt, name])
}

model DishIngredient {
  id    String  @id @default(cuid()) @map("id_dish_ingredient")
  count Decimal @db.Decimal(12, 3)

  idDish String @map("id_dish")
  dish   Dish   @relation(fields: [idDish], references: [id], onDelete: Cascade)

  idProduct String  @map("id_product")
  product   Product @relation(fields: [idProduct], references: [id])

  @@unique([idDish, idProduct])
  @@map("dish_ingredients")
}

model StockMovement {
  id         String   @id @default(cuid()) @map("id_stock_movement")
  count      Decimal  @db.Decimal(12, 3)
  createDate DateTime @default(now()) @map("create_date")

  idBatch String @map("id_batch")
  batch   Batch  @relation(fields: [idBatch], references: [id])

  idOrder String? @map("id_order")
  order   Order?  @relation(fields: [idOrder], references: [id])

  // Пусто — списала система: партия просрочилась (заказа тоже нет)
  createrId String? @map("creater_id")
  creater   User?   @relation(fields: [createrId], references: [id], onDelete: Restrict)

  messages Message[]

  @@map("stock_movement")
}

model Message {
  id         String      @id @default(cuid()) @map("id_message")
  type       MessageType
  createDate DateTime    @default(now()) @map("create_date")
  isRead     Boolean     @default(false) @map("is_read")

  idRecipient String @map("id_recipient")
  recipient   User   @relation(fields: [idRecipient], references: [id], onDelete: Cascade)

  idStockMovement String?        @map("id_stock_movement")
  stockMovement   StockMovement? @relation(fields: [idStockMovement], references: [id], onDelete: Cascade)

  @@index([idRecipient, isRead])
  @@map("messages")
}

// Блюдо в стопе, пока есть открытая запись (closedAt пусто). Снятые записи —
// история «поставлен/снят», хранятся неделю и удаляются автоматически
model StopList {
  id        String    @id @default(cuid()) @map("id_stop_list")
  type      StopType
  createdAt DateTime  @default(now()) @map("created_at")
  closedAt  DateTime? @map("closed_at")

  idDish String @map("id_dish")
  dish   Dish   @relation(fields: [idDish], references: [id], onDelete: Cascade)

  createrId String? @map("creater_id")
  creater   User?   @relation(fields: [createrId], references: [id])

  @@index([idDish, closedAt])
  @@index([closedAt])
  @@map("stop_list")
}

// Настройки ресторана — ровно одна строка (id = 1), меняет менеджер.
// Значения по умолчанию утверждены: запас на готовку 30 мин;
// «срочно» — осталось не больше 25 % срока хранения, но в пределах 24 ч … 7 дн; горячих блюд 3
model Settings {
  id                 Int      @id @default(1)
  cookReserveMinutes Int      @default(30) @map("cook_reserve_minutes")
  urgentPercent      Int      @default(25) @map("urgent_percent")
  urgentMinHours     Int      @default(24) @map("urgent_min_hours")
  urgentMaxHours     Int      @default(168) @map("urgent_max_hours")
  hotLimit           Int      @default(3) @map("hot_limit")
  // За сколько дней считать спрос на блюдо для горячих предложений
  demandDays         Int      @default(7) @map("demand_days")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("settings")
}

// Отклонённые заказы — для менеджера: какой спрос не удалось закрыть и почему.
// Официанту и кухне журнал не показывается
model OrderRejection {
  id         String          @id @default(cuid()) @map("id_order_rejection")
  createDate DateTime        @default(now()) @map("create_date")
  reason     RejectionReason
  // Снимок чека на момент отказа: блюдо, порции, что гость просил убрать
  lines      Json
  // Блюда в стоп-листе и недостающие продукты: сколько нужно и сколько было годного
  details    Json

  // Имя — снимком: журнал переживает удаление сотрудника
  waiterName String          @map("waiter_name")
  waiterId   String?         @map("waiter_id")
  waiter     User?           @relation(fields: [waiterId], references: [id], onDelete: SetNull)

  @@index([createDate])
  @@map("order_rejections")
}
